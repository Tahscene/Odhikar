# Copy this file to .env for local testing.
# On Render, set these same keys in the "Environment" tab instead.

# Supabase Postgres connection string
# Get this from: Supabase project -> Settings -> Database -> Connection string (URI, "Session pooler" mode)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT].supabase.co:5432/postgres

# Google Gemini API key -> https://aistudio.google.com/apikey
# OPTIONAL: Without this key, the app still works - Summarizer shows relevant
# laws from the knowledge base, and NagorikBot shows a fallback message.
# Gemini's free tier is enough for demo/development use.
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any long random string, used to sign login tokens
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of frontend URLs allowed to call this API
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
